# Token for SilverBullet's HTTP API.
# Use the same value as SB_AUTH_TOKEN in SilverBullet's own .env.
SB_AUTH_TOKEN=changeme

# Where this container reaches SilverBullet. On a shared docker network the
# service name is enough, and the traffic never leaves the host.
SILVERBULLET_URL=http://silverbullet:3000

# Public URL of your SilverBullet, used only to build clickable links in the
# graph. Set this or every node click will go somewhere useless.
SILVERBULLET_PUBLIC_URL=https://silverbullet.example.com

# Seconds between reconciles. This is the worst-case staleness for pages
# written outside the editor.
RECONCILE_INTERVAL=300

# Comma-separated folder prefixes to keep out of the graph.
EXCLUDE_PREFIXES=Library/

LOG_LEVEL=INFO
